APP_URL=http://localhost:3000
PORT=3000
DATA_DIR=./data
# First startup only. Set privately; never commit a real password.
ADMIN_PASSWORD=
# Optional: both are required to enable online payments (API individual keys).
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
# Set only behind a trusted reverse proxy that appends/overwrites this header.
TRUST_PROXY=false
